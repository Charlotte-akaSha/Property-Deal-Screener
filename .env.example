# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Verify current multimodal model names before setting.
# Example: gemini-3.6-flash (required for new API keys; replaces gemini-2.5-flash)
GEMINI_MODEL=gemini-3.6-flash
# Optional fallbacks on 503/unavailable model (not used for daily quota 429)
# GEMINI_MODEL_FALLBACKS=gemini-3.6-flash

# Analysis LLM (default: Gemini). Omit ANALYSIS_BACKEND or set gemini.
# ANALYSIS_BACKEND=gemini
# ANALYSIS_FAST_MODE=true
# GEMINI_FAST_MODEL=gemini-3.6-flash
# ANALYSIS_FULL_RES_IMAGES=true
# MARKET_RESEARCH_USE_SEARCH=true
# MARKET_RESEARCH_SEARCH_TIMEOUT_SEC=90

# OpenRouter (see docs/openrouter-setup.md)
# ANALYSIS_BACKEND=openrouter
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_FAST_MODEL=google/gemini-2.5-flash
# COMPOSER_FALLBACK_TO_GEMINI=false

# Cursor subscription: local bridge + user API key (see docs/composer-setup.md)
# ANALYSIS_BACKEND=composer
# COMPOSER_API_BASE_URL=http://127.0.0.1:8787/v1
# COMPOSER_API_KEY=local
# COMPOSER_MODEL=composer-2.5-fast
# COMPOSER_FAST_MODEL=composer-2.5-fast
# COMPOSER_FALLBACK_TO_GEMINI=false

# Google Sheet ID from the spreadsheet URL:
# https://docs.google.com/spreadsheets/d/<GOOGLE_SHEETS_ID>/edit
GOOGLE_SHEETS_ID=

# Path to service account JSON (relative to project root or absolute)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json

# Default tab if GOOGLE_SHEETS_REGIONS is not set
GOOGLE_SHEETS_TAB=Properties

# URL-only batch import (opens visible Chrome — recommended)
# ZILLOW_AUTO_CDP=true
# ZILLOW_BROWSER_PROFILE=.cache/zillow-chrome-profile
# ZILLOW_FETCH_DELAY_SEC=4
# ZILLOW_CAPTCHA_WAIT_SEC=600
# ZILLOW_CDP_URL=http://127.0.0.1:9222

# Google Maps API key (Geocoding, Places, Distance Matrix, Directions)
# https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=

# Optional city-center overrides per region tab (defaults: Grand Central / Millennium Station)
# CITY_CENTER_NEW_YORK=Grand Central Terminal, New York, NY
# CITY_CENTER_CHICAGO=Millennium Station, Chicago, IL
# CITY_CENTER_COLUMBUS=Downtown Columbus, OH
# CITY_CENTER_OSU_COLUMBUS=Ohio State University, Columbus, OH
# CITY_CENTER_DEFAULT=

# Create matching tab names in your Google Sheet (e.g. New York, Chicago, Columbus).
GOOGLE_SHEETS_REGIONS=New York,Chicago,Columbus
